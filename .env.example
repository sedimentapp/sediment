# One token per source; the variable name comes from the profile (token_env),
# so a second YouTrack would use e.g. ACME_YOUTRACK_TOKEN.
YOUTRACK_TOKEN=
MATTERMOST_TOKEN=
QDRANT_URL=
# Optional when Qdrant authentication is enabled:
QDRANT_API_KEY=
EMBED_URL=
EMBED_MODEL=bge-m3
# Optional for an external OpenAI-compatible embedding provider:
EMBED_API_KEY=
